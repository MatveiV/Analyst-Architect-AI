+
+# ─── C6: честные метрики по провайдеру ────────────────────────────────────────
+
+@pytest.mark.asyncio
+async def test_stats_by_provider_endpoint_shape(client, auth_headers, db_session):
+    """
+    БД в тестовой сессии общая для всех тестов (session-scoped client), поэтому агрегаты
